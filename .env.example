# Auth.js / NextAuth — copy to `.env.local` and fill in values.
#
# If you see "There was a problem with the server configuration" (Configuration error),
# you are almost always missing AUTH_SECRET in production, or it was never set locally.
#
# Generate a secret: `npx auth secret`

AUTH_SECRET=

# Site URL on your real server (Vercel/Node host). Set to the public https origin
# (no trailing path). Helps Auth.js callbacks and host trust on production.
# AUTH_URL=https://your-domain.com

# --- Google OAuth ---
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
# (and http://localhost:3000/api/auth/callback/google for local dev)

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Sign in with Apple ---
# Apple does not allow http://localhost for Sign in with Apple.
# Use a deployed HTTPS URL for testing Apple, or a tunnel (e.g. ngrok).
# Client secret is a JWT — helper: `npx auth add apple`
# Callback URL: https://YOUR_DOMAIN/api/auth/callback/apple

AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
