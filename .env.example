# Auth.js / NextAuth — copy to `.env.local` and fill in values.
#
# If you see "There was a problem with the server configuration" (Configuration error),
# you are almost always missing AUTH_SECRET in production, or it was never set locally.
#
# Generate a secret: `npx auth secret`

AUTH_SECRET=

# Site URL on your real server (Vercel/Node host). Set to the public https origin
# (no trailing path). Helps Auth.js callbacks and host trust on production.
# AUTH_URL=https://your-domain.com

# --- Google OAuth ---
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
# (and http://localhost:3000/api/auth/callback/google for local dev)

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Sign in with Apple ---
# Apple does not allow http://localhost for Sign in with Apple.
# Use a deployed HTTPS URL for testing Apple, or a tunnel (e.g. ngrok).
# Client secret is a JWT — helper: `npx auth add apple`
# Callback URL: https://YOUR_DOMAIN/api/auth/callback/apple

AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# --- Vaccine Talks chatbot (Groq, server-side only) ---
# Get a key: https://console.groq.com/keys
# Copy this file to `.env.local`, set the value, then restart `npm run dev`.
# Do NOT use NEXT_PUBLIC_ — the key must stay on the server.

GROQ_API_KEY=

# --- Search engine verification (optional) ---
# Google Search Console → HTML tag method → paste the content value only.
# GOOGLE_SITE_VERIFICATION=your-google-verification-code
#
# Bing Webmaster Tools → Meta tag → paste the content value only.
# BING_SITE_VERIFICATION=your-bing-verification-code

# --- Website content push notifications (Web Push + VAPID) ---
# Generate keys: `npx web-push generate-vapid-keys`
# The public key is used by the browser. The private key must stay on the server.
# Subject should be a mailto: or https: URL identifying the site.

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@vaccinetalks.com

# Subscription store (Upstash Redis REST, or Vercel KV which uses the same REST API).
# Create a Redis/KV store in Vercel Storage or Upstash, then paste the REST URL and token.
# Do not commit real tokens.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional aliases if the store was created as Vercel KV:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Protects POST /api/content-notifications/admin/send
# Send header: Authorization: Bearer <secret>
# Or: x-admin-notification-secret: <secret>
# Generate a long random string. Never expose this to the browser (no NEXT_PUBLIC_).

ADMIN_NOTIFICATION_SECRET=
